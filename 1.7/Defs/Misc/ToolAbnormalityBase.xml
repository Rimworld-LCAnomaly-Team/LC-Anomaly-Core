<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Inert minimal anatomical body for containment-platform tool entities (core vanilla parts only, Anomaly-DLC free) -->
  <BodyDef>
    <defName>LC_ToolAbnormalityBody</defName>
    <label>tool abnormality</label>
    <corePart>
      <def>Torso</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <groups>
        <li>Torso</li>
      </groups>
      <parts>
        <li>
          <def>Spine</def>
          <coverage>0.03</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Stomach</def>
          <coverage>0.03</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Heart</def>
          <coverage>0.03</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Lung</def>
          <customLabel>left lung</customLabel>
          <coverage>0.03</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Lung</def>
          <customLabel>right lung</customLabel>
          <coverage>0.03</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Kidney</def>
          <customLabel>left kidney</customLabel>
          <coverage>0.02</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Kidney</def>
          <customLabel>right kidney</customLabel>
          <coverage>0.02</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Liver</def>
          <coverage>0.03</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Neck</def>
          <coverage>0.08</coverage>
          <height>Top</height>
          <groups>
            <li>Neck</li>
          </groups>
          <parts>
            <li>
              <def>Head</def>
              <coverage>0.80</coverage>
              <groups>
                <li>UpperHead</li>
                <li>FullHead</li>
              </groups>
              <parts>
                <li>
                  <def>Skull</def>
                  <coverage>0.18</coverage>
                  <depth>Inside</depth>
                  <groups>
                    <li>UpperHead</li>
                    <li>FullHead</li>
                  </groups>
                  <parts>
                    <li>
                      <def>Brain</def>
                      <coverage>0.8</coverage>
                      <groups>
                        <li>UpperHead</li>
                        <li>FullHead</li>
                      </groups>
                    </li>
                  </parts>
                </li>
              </parts>
            </li>
          </parts>
        </li>
      </parts>
    </corePart>
  </BodyDef>

  <!-- Completely passive ThinkTree for tool abnormalities (no attack, react, or wander nodes) -->
  <ThinkTreeDef>
    <defName>LC_ToolAbnormality</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree"><treeDef>Downed</treeDef></li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- Abstract Pawn base for holding-platform Tool Abnormalities -->
  <LCAnomalyCore.Defs.ThingDef_AbnormalityEntity ParentName="LC_EntityBase" Name="LC_ToolEntityBase" Abstract="True">
    <thingClass>LCAnomalyCore.Comp.LC_ToolEntityPawn</thingClass>
    <statBases>
      <MoveSpeed>0</MoveSpeed>
      <Flammability>0</Flammability>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>100</ComfyTemperatureMax>
      <PsychicSensitivity>0</PsychicSensitivity>
      <LC_MinimumContainmentStrength>0</LC_MinimumContainmentStrength>
      <StaggerDurationFactor>0</StaggerDurationFactor>
      <ToxicResistance>1</ToxicResistance>
    </statBases>
    <race>
      <body>LC_ToolAbnormalityBody</body>
      <baseBodySize>1</baseBodySize>
      <baseHealthScale>2.5</baseHealthScale>
      <doesntMove>true</doesntMove>
      <intelligence>ToolUser</intelligence>
      <needsRest>false</needsRest>
      <hasGenders>false</hasGenders>
      <fleshType>LC_AbnormalityMechanical</fleshType>
      <foodType>None</foodType>
      <hasCorpse>false</hasCorpse>
      <lifeExpectancy>1000</lifeExpectancy>
      <disableIgniteVerb>true</disableIgniteVerb>
      <trainability>None</trainability>
      <renderTree>Animal</renderTree>
      <thinkTreeMain>LC_ToolAbnormality</thinkTreeMain>
      <thinkTreeConstant>LC_AbnormalityConstant</thinkTreeConstant>
      <lifeStageAges>
        <li>
          <def>LC_EntityFullyFormed</def>
        </li>
      </lifeStageAges>
    </race>
    <comps>
      <li Class="LCAnomalyCore.Comp.CompProperties_Abnormality">
        <qliphothCountMax>-1</qliphothCountMax>
        <studySucessRateBase>0.5</studySucessRateBase>
        <shouldNotifyWhenEscape>false</shouldNotifyWhenEscape>
        <ifProvideWarningPoints>false</ifProvideWarningPoints>
        <customWarningPoints>-1</customWarningPoints>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityHoldingPlatformTarget">
        <lookForTargetOnEscape>false</lookForTargetOnEscape>
        <hasAnimation>false</hasAnimation>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityStudiable">
        <frequencyTicks>60000</frequencyTicks>
        <studyTimesPeriod>1</studyTimesPeriod>
        <studyEnabledByDefault>false</studyEnabledByDefault>
        <showToggleGizmo>false</showToggleGizmo>
      </li>
    </comps>
  </LCAnomalyCore.Defs.ThingDef_AbnormalityEntity>

  <!-- Abstract PawnKind base for holding-platform Tool Abnormalities -->
  <LCAnomalyCore.Defs.PawnKindDef_AbnormalityEntity Name="LC_ToolEntityKindBase" Abstract="True">
    <canMeleeAttack>false</canMeleeAttack>
    <defaultFactionType>LC_Abnormalities</defaultFactionType>
    <overrideDebugActionCategory>Entity</overrideDebugActionCategory>
    <forceDeathOnDowned>true</forceDeathOnDowned>
    <combatPower>10</combatPower>
  </LCAnomalyCore.Defs.PawnKindDef_AbnormalityEntity>

</Defs>
