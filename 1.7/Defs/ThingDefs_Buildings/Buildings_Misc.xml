<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Room Containment Terminal -->
  <ThingDef ParentName="FurnitureBase">
    <defName>LC_ContainmentTerminal</defName>
    <label>Containment Room Terminal</label>
    <description>A wall-side containment control terminal that turns an enclosed indoor room into a live Lobotomy Corporation containment unit.\n\nInstead of chaining abnormalities to a platform, captured entities reside directly inside the enclosed room where employees enter to perform work. Only one terminal can be active per room.</description>
    <thingClass>LCAnomalyCore.Buildings.Building_AbnormalityContainmentTerminal</thingClass>
    <drawGUIOverlay>true</drawGUIOverlay>
    <passability>PassThroughOnly</passability>
    <rotatable>false</rotatable>
    <fillPercent>0.4</fillPercent>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <uiOrder>105</uiOrder>
    <pathCost>14</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <size>(1, 1)</size>
    <defaultPlacingRot>North</defaultPlacingRot>
    <graphicData>
      <texPath>Things/Building/LC_ContainmentTerminal/ContainmentTerminal</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1, 1)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/LC_ContainmentTerminal/ContainmentTerminal</uiIconPath>
    <thingCategories>
      <li>LC_Building_Containment</li>
    </thingCategories>
    <inspectorTabs>
      <li>LCAnomalyCore.UI.ITab_AbnormalityStudyNotes</li>
    </inspectorTabs>
    <designationCategory>Buildings_LC</designationCategory>
    <placeWorkers>
      <li>LCAnomalyCore.Buildings.PlaceWorker_AbnormalityContainmentTerminal</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>LC_EntityContainment</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Mass>15</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <costList>
      <Steel>35</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <building>
      <buildingTags>
        <li>Anomaly</li>
      </buildingTags>
    </building>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
        </linkableFacilities>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_WorkableUI" />
      <li Class="CompProperties_AssignableToPawn">
        <drawAssignmentOverlay>false</drawAssignmentOverlay>
        <compClass>LCAnomalyCore.Comp.CompAssignableToPawn_LC_Entity</compClass>
        <maxAssignedPawnsCount>12</maxAssignedPawnsCount>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityHolderRoom">
        <containmentFactor>1.0</containmentFactor>
        <breachGraceTicks>120</breachGraceTicks>
      </li>
    </comps>
  </ThingDef>

</Defs>
