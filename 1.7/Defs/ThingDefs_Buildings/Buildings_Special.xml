<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Cogito Bucket -->
  <ThingDef ParentName="BuildingBase">
    <defName>CogitoBucket</defName>
    <label>"The Bucket"</label>
    <description>A deep-well containment vessel used to house and draw raw Cogito—the foundational origin of Abnormality extraction and Lobotomy Corporation operations.\n\n- Converts harvested human brain-spinal nerves into raw Cogito while powered.\n- Can also launch the 3-Choice Abnormality Extraction terminal.</description>
    <thingClass>LCAnomalyCore.Buildings.Building_CogitoBucket</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/TheBucket/TheBucket_WithFloor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3, 3)</drawSize>
      <shadowData>
        <volume>(1.8, 1.0, 0.2)</volume>
        <offset>(0.0, 0.0, -0.4)</offset>
      </shadowData>
    </graphicData>
    <thingCategories>
      <li>LC_Building_Production</li>
    </thingCategories>
    <designationCategory>Buildings_LC</designationCategory>
    <costList>
      <Steel>2000</Steel>
      <ComponentSpacer>10</ComponentSpacer>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="LCAnomalyCore.Comp.CompProperties_CogitoBucketSpawner">
        <requiresPower>true</requiresPower>
        <thingToSpawn>Cogito</thingToSpawn>
        <thingRequire>BrainSpinalNerve</thingRequire>
        <spawnCount>10</spawnCount>
        <spawnIntervalRange><min>120000</min><max>120000</max></spawnIntervalRange>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
        <showMessageIfOwned>true</showMessageIfOwned>
      </li>
    </comps>
    <altitudeLayer>Building</altitudeLayer>
    <statBases>
      <MarketValue>1500</MarketValue>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Beauty>-10</Beauty>
      <Mass>35</Mass>
      <WorkToBuild>8000</WorkToBuild>
    </statBases>
    <placeWorkers>
      <li>PlaceWorker_NoiseSource</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>Enkephalin_ElectricGenerator</li>
    </researchPrerequisites>
    <size>(3, 3)</size>
    <fillPercent>1.0</fillPercent>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <passability>Impassable</passability>
    <rotatable>true</rotatable>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <tradeability>Sellable</tradeability>
  </ThingDef>

  <!-- Abnormality Extraction Well (early-game Cognitive Well terminal) -->
  <ThingDef ParentName="BuildingBase">
    <defName>LC_ExtractionWell</defName>
    <label>abnormality extraction well</label>
    <description>An early-stage Cognitive Well terminal connected to the deep layer of the human psyche. Even before a full Cogito Bucket is constructed, the manager can resonance-cast into the well to extract three candidate Abnormality containers.\n\n- Requires 120W power when operational.\n- Costs Cogito or Enkephalin Boxes per extraction (first extraction on a new colony charter is free).\n- Can also be operated directly from the Lobotomy Control tab or a powered Cogito Bucket.</description>
    <thingClass>LCAnomalyCore.Buildings.Building_ExtractionWell</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/TheWell/TheWell</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3, 3)</drawSize>
      <shadowData>
        <volume>(1.8, 0.8, 1.8)</volume>
        <offset>(0.0, 0.0, -0.2)</offset>
      </shadowData>
    </graphicData>
    <thingCategories>
      <li>LC_Building_Production</li>
    </thingCategories>
    <designationCategory>Buildings_LC</designationCategory>
    <uiIconPath>Things/Building/TheWell/TheWell</uiIconPath>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>120</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(90, 210, 255, 0)</glowColor>
      </li>
    </comps>
    <altitudeLayer>Building</altitudeLayer>
    <statBases>
      <MarketValue>420</MarketValue>
      <MaxHitPoints>220</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <Beauty>-2</Beauty>
      <Mass>28</Mass>
      <WorkToBuild>2200</WorkToBuild>
    </statBases>
    <researchPrerequisites>
      <li>ExtractAbnormalityRiturals</li>
    </researchPrerequisites>
    <size>(3, 3)</size>
    <fillPercent>0.75</fillPercent>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <rotatable>false</rotatable>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <tradeability>Sellable</tradeability>
  </ThingDef>

</Defs>
